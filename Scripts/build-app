#!/bin/zsh

set -euo pipefail

profile=${1:-}

case "$profile" in
    debug)
        configuration=debug
        app_name="Kkaci Dev"
        bundle_identifier="dev.kkaci.app.debug"
        ;;
    release)
        configuration=release
        app_name="Kkaci"
        bundle_identifier="dev.kkaci.app"
        ;;
    *)
        print -u2 "usage: $0 <debug|release>"
        exit 2
        ;;
esac

root_directory=$(cd "$(dirname "$0")/.." && pwd)
cd "$root_directory"

swift build --configuration "$configuration" --product Kkaci
binary_directory=$(swift build --configuration "$configuration" --show-bin-path)

app_directory="$root_directory/.build/apps/$configuration/$app_name.app"
contents_directory="$app_directory/Contents"
executable_directory="$contents_directory/MacOS"
plist="$contents_directory/Info.plist"
plist_template="$root_directory/Support/App/Info.plist"

rm -rf "$app_directory"
mkdir -p "$executable_directory"
cp "$binary_directory/Kkaci" "$executable_directory/Kkaci"
cp "$plist_template" "$plist"

plutil -replace CFBundleDisplayName -string "$app_name" "$plist"
plutil -replace CFBundleName -string "$app_name" "$plist"
plutil -replace CFBundleIdentifier -string "$bundle_identifier" "$plist"

print "$app_directory"
